# Non-secret function params (defineBoolean/defineString in flags.ts and
# clockEvents.ts) for the orbitworks-dev-ew dev project. No defineSecret
# values ever belong in a file like this - those are set via
# `firebase functions:secrets:set` instead (see functions/src/rekognition.ts,
# geocoding.ts, lib/resend.ts).

# Device Recognition Pro - kept off, same as the local emulator default
# (.env.local). Flip on only if you're specifically testing that feature.
DEVICE_TRACKING_ENABLED=false

# Master kill switch for the whole alert-generation system, including the
# 3 new Face Verification alert types - needs to be true to see ANY alert
# fire on this project (lateClockIn, faceMismatch, etc).
ALERTS_FEED_ENABLED=true

# Off by default so dev testing never pushes to a real device. Flip to
# true once you're ready to test push delivery itself - note the mobile
# app also needs its EAS "dev" build profile (eas.json) pointed at this
# project first, or there won't be any push tokens registered here at all.
PUSH_NOTIFICATIONS_ENABLED=false

# Empty = unrestricted (every company on this project gets alerts once
# ALERTS_FEED_ENABLED is on) - there's no equivalent yet of prod's
# TEST_COMPANY_IDS value (that's a real prod company id; it doesn't exist
# in this project's Firestore, so it wouldn't do anything useful here).
TEST_COMPANY_IDS=
