# Copy to .env.local and fill in. See lib/firebase.ts - the 6 Firebase
# vars below are required at startup (throws if any are missing); every
# other var here is required by whatever feature reads it, but won't
# crash the app at boot if missing.

# --- Firebase client config (public - ships in every browser bundle) ---
# Firebase console > Project settings > General > Your apps > SDK setup,
# or `firebase apps:sdkconfig web --project <project-id>`.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional - omit to skip an explicit GA4 measurement id.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Firebase Admin SDK (server-only, Next.js API routes) ---
# From a service account key JSON for the SAME project as
# NEXT_PUBLIC_FIREBASE_PROJECT_ID above. FIREBASE_ADMIN_PRIVATE_KEY keeps
# its \n escapes literal (don't convert to real newlines).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Stripe ---
# Use TEST-mode keys/price IDs for local dev - never live/production
# keys outside of Vercel's Production environment.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# (prints a whsec_... value each time you start it - it changes per run).
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PRICE_TIER1=
NEXT_PUBLIC_STRIPE_PRICE_TIER2=
NEXT_PUBLIC_STRIPE_PRICE_TIER3=
NEXT_PUBLIC_STRIPE_PRICE_TIER4=
NEXT_PUBLIC_STRIPE_PRICE_TIER5=
# Optional - Pro pricing just doesn't appear in PRICE_TIERS if these are
# unset (lib/stripe/tiers.ts).
NEXT_PUBLIC_STRIPE_PRICE_PRO_TIER1=
NEXT_PUBLIC_STRIPE_PRICE_PRO_TIER2=
NEXT_PUBLIC_STRIPE_PRICE_PRO_TIER3=
NEXT_PUBLIC_STRIPE_PRICE_PRO_TIER4=
NEXT_PUBLIC_STRIPE_PRICE_PRO_TIER5=

# --- Other server-side API keys ---
ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=
