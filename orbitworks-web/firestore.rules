rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function companyOf(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)).data;
    }

    // Owner is a superset of admin - the single original-signup account
    // per company, the only role with billing/Stripe access, but
    // otherwise able to do everything admin can. Everywhere the app used
    // to gate on role == 'admin' for general (non-billing) actions now
    // goes through this helper instead.
    function isAdminOrOwner() {
      return request.auth.token.role == 'admin' || request.auth.token.role == 'owner';
    }

    function underCap(companyId) {
      let c = companyOf(companyId);
      let cap = c.get('employeeCap', null);
      let count = c.get('activeEmployeeCount', 0);
      return cap == null || !(count >= cap);
    }

    function notPastDue(companyId) {
      return companyOf(companyId).get('subscriptionStatus', 'active') != 'past_due';
    }

    // The calling supervisor's own employee doc, looked up by the
    // employeeId custom claim rather than request.auth.uid - employees
    // doc IDs are never assumed to equal the linked auth uid (a
    // promoted-in-place employee keeps its original doc ID), so this is
    // the only way rules can resolve "my own employee record" with a
    // single get() (rules can't run a where('linkedUserId','==',uid)
    // query). The employeeId claim is set by acceptInvite and
    // setEmployeeRole whenever a user gets linked to an employee doc.
    // Falls back to request.auth.uid when the employeeId claim isn't on
    // the token yet - true for every already-signed-in supervisor until
    // they get a fresh ID token (migrate-owner-role.js backfills the
    // claim, but there's no way to force a refresh of tokens already in
    // flight). Safe because doc id == uid for every employee linked
    // before this claim existed, so the fallback resolves to the same
    // doc the old uid-keyed lookup did.
    function isActiveEmployee(companyId) {
      let employeeId = request.auth.token.get('employeeId', request.auth.uid);
      return get(/databases/$(database)/documents/companies/$(companyId)/employees/$(employeeId)).data.active == true;
    }

    // A deactivated employee can still have an open clock session (the
    // deactivation write itself auto-closes it, but this is the safety net
    // for when that write fails, plus the backfill path for sessions that
    // were already orphaned before that fix shipped). Such an employee must
    // still be clockable OUT - just never back IN or onto a new break -
    // so admin manual clock-out, the Alerts panel, and the mobile app can
    // all still close it out. lastEventType is the same denormalized field
    // onClockEventCreated keeps in sync, so this needs only one get(), no
    // query.
    function isActiveOrClosingOpenSession(companyId, employeeId, data) {
      let e = get(/databases/$(database)/documents/companies/$(companyId)/employees/$(employeeId)).data;
      return e.active == true ||
        (e.get('lastEventType', 'out') != 'out' && data.type in ['out', 'breakEnd']);
    }

    function isActiveSupervisor(companyId, employeeId) {
      let e = get(/databases/$(database)/documents/companies/$(companyId)/employees/$(employeeId)).data;
      return e.active == true && e.isSupervisor == true;
    }

    function requiresOverrideReason(companyId) {
      return companyOf(companyId).get('attendanceRules', {}).get('requireOverrideReason', true);
    }

    // A supervisorOverride clock event must name a real, currently active
    // supervisor as authorizedById (not just any client-supplied string) so
    // the audit trail this feature exists to build can't be self-forged by
    // whoever already has write access to clockEvents. reason, if present,
    // must always be well-formed (matches overrideReasonSchema's 10-500
    // bound); it's only required to be present when the company's
    // "Require Reason for Supervisor Overrides" setting is on - enforced
    // here rather than only in OverrideReasonScreen.js so it can't be
    // skipped by writing directly to Firestore.
    function isValidOverride(companyId, data) {
      return data.source != 'supervisorOverride' ||
        (
          data.authorizedById is string &&
          isActiveSupervisor(companyId, data.authorizedById) &&
          (
            data.reason == null ||
            (data.reason is string && data.reason.size() >= 10 && data.reason.size() <= 500)
          ) &&
          (!requiresOverrideReason(companyId) || data.reason != null)
        );
    }

    function isValidClockEventType(data) {
      return data.type in ['in', 'out', 'breakStart', 'breakEnd'];
    }

    // True only when an update targets the identical logical event a
    // supervisor already created - same localId, same author. This is
    // what an idempotent retry looks like after an app crash between
    // the Firestore write succeeding and the local queue cleanup
    // finishing (see queueSync.js). It intentionally does not allow
    // changing type, employeeId, or timestamps - only a same-identity
    // replay, never an after-the-fact edit of someone's clocked time.
    function isIdempotentReplay(companyId) {
      return request.auth.token.role == 'supervisor' &&
        isActiveEmployee(companyId) &&
        resource.data.createdByUid == request.auth.uid &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.localId == resource.data.localId &&
        request.resource.data.employeeId == resource.data.employeeId &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.clientTimestamp == resource.data.clientTimestamp;
    }

    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (isAdminOrOwner() &&
         request.auth.token.companyId == resource.data.companyId)
      );
      allow create, update, delete: if false;
    }

    match /companies/{companyId} {
      allow read: if request.auth != null &&
        request.auth.token.companyId == companyId;
      allow create: if false;
      allow update: if request.auth != null &&
        isAdminOrOwner() &&
        request.auth.token.companyId == companyId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'planTier',
          'employeeCap',
          'subscriptionStatus',
          'activeEmployeeCount',
          'stripeCustomerId',
          'stripeSubscriptionId',
          'trialEndsAt'
        ]);
      allow delete: if false;

      match /jobSites/{siteId} {
        allow read: if request.auth != null &&
          request.auth.token.companyId == companyId;
        allow write: if request.auth != null &&
          isAdminOrOwner() &&
          request.auth.token.companyId == companyId;
      }

      match /jobs/{jobId} {
        allow read: if request.auth != null &&
          request.auth.token.companyId == companyId;
        allow write: if request.auth != null &&
          isAdminOrOwner() &&
          request.auth.token.companyId == companyId;
      }

      match /subcontractors/{subcontractorId} {
        allow read: if request.auth != null &&
          request.auth.token.companyId == companyId;
        allow write: if request.auth != null &&
          isAdminOrOwner() &&
          request.auth.token.companyId == companyId;
      }

      match /employees/{employeeId} {
        allow read: if request.auth != null &&
          request.auth.token.companyId == companyId;

        allow create: if request.auth != null &&
          isAdminOrOwner() &&
          request.auth.token.companyId == companyId &&
          (request.resource.data.active != true || (underCap(companyId) && notPastDue(companyId)));

        // isAdmin/isSupervisor/linkedUserId are role-like fields - only
        // acceptInvite, setEmployeeRole, setEmployeePinSupervisor, and
        // deleteEmployee (all Admin SDK, bypass rules) may change them,
        // so they're kept in sync
        // with users/{uid}.role and the custom claim. Same lockdown
        // pattern as 'pin' below.
        allow update: if request.auth != null &&
          isAdminOrOwner() &&
          request.auth.token.companyId == companyId &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['subcontractorId', 'subcontractorName', 'subcontractorHistory', 'pin', 'isAdmin', 'isSupervisor', 'linkedUserId']) &&
          (
            request.resource.data.active != true ||
            resource.data.active == true ||
            (underCap(companyId) && notPastDue(companyId))
          );

        // No client, including admins, may delete an employee doc
        // directly - the only path is the deleteEmployee callable (Admin
        // SDK, bypasses rules), which closes any open session, releases
        // the PIN, and cleans up the linked Auth account/invite first.
        // clockEvents/timesheetApprovals denormalize employeeName/
        // siteName/etc at write time, so historical timesheets and
        // reports still read correctly after this doc is gone.
        allow delete: if false;
      }

      match /pins/{pinId} {
        // Server-only reservation index for PIN uniqueness (see
        // setEmployeePin / backfillEmployeePins / reserveNewPin in
        // functions). No client needs to read or write this directly -
        // the Admin SDK bypasses rules entirely, so this is an explicit,
        // readable deny rather than relying on it falling through
        // unmatched.
        allow read, write: if false;
      }

      match /clockEvents/{eventId} {
        allow read: if request.auth != null &&
          request.auth.token.companyId == companyId;
        allow create: if request.auth != null &&
          request.auth.token.companyId == companyId &&
          isValidClockEventType(request.resource.data) &&
          isActiveOrClosingOpenSession(companyId, request.resource.data.employeeId, request.resource.data) &&
          (
            isAdminOrOwner() ||
            (request.auth.token.role == 'supervisor' &&
             isActiveEmployee(companyId))
          ) &&
          request.resource.data.createdByUid == request.auth.uid &&
          isValidOverride(companyId, request.resource.data);
        allow update: if request.auth != null &&
          request.auth.token.companyId == companyId &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['type', 'timestamp', 'adjustedTimestamp', 'adjustmentHistory', 'employeeId', 'employeeName', 'subcontractorId', 'subcontractorName', 'reason']) &&
          (
            isAdminOrOwner() ||
            isIdempotentReplay(companyId)
          );
        allow delete: if request.auth != null &&
          isAdminOrOwner() &&
          request.auth.token.companyId == companyId;
      }

      match /alertActions/{actionId} {
        allow read: if request.auth != null &&
          request.auth.token.companyId == companyId;
        allow create: if request.auth != null &&
          request.auth.token.companyId == companyId &&
          (
            isAdminOrOwner() ||
            (request.auth.token.role == 'supervisor' &&
             isActiveEmployee(companyId))
          ) &&
          request.resource.data.resolvedByUid == request.auth.uid;
        allow update, delete: if false;
      }

      match /shiftNotes/{noteId} {
        allow read: if request.auth != null &&
          request.auth.token.companyId == companyId;
        allow write: if request.auth != null &&
          request.auth.token.companyId == companyId &&
          (isAdminOrOwner() || request.auth.token.role == 'supervisor');
      }

      match /timesheetApprovals/{eventId} {
        // Admin/owner-only, server-created. Written only by
        // onClockEventCreated and setApprovalStatus (both Admin SDK,
        // bypass rules entirely) - clients can read for the Approvals
        // page but never write status/approvedBy/approvedAt directly,
        // same lockdown pattern as adjustmentHistory on clockEvents.
        allow read: if request.auth != null &&
          request.auth.token.companyId == companyId &&
          isAdminOrOwner();
        allow write: if false;
      }

      match /overrideEvents/{overrideEventId} {
        // Server-created only, by onClockEventCreated (Admin SDK, bypasses
        // rules entirely) whenever a supervisorOverride clock event carries
        // a reason. Same lockdown pattern as timesheetApprovals - clients
        // read for the Approvals page's override-detail view, never write.
        allow read: if request.auth != null &&
          request.auth.token.companyId == companyId &&
          isAdminOrOwner();
        allow write: if false;
      }
    }

    // Help-chat telemetry - server-only, written by the Admin SDK from
    // app/api/help-chat/route.ts and lib/help-chat/rateLimit.ts. This is
    // internal training/eval data (what answered well, what missed, what
    // errored) - not a user-facing feature, so no client, including admins,
    // ever needs to read or write it. Explicit deny rather than relying on
    // the trailing catch-all, same pattern as /pins.
    match /helpChatLimits/{docId} {
      allow read, write: if false;
    }
    match /helpChatLogs/{logId} {
      allow read, write: if false;
    }
    match /helpChatMisses/{missId} {
      allow read, write: if false;
    }
    match /helpChatErrors/{errId} {
      allow read, write: if false;
    }

    match /invites/{inviteId} {
      // emailStatus/emailSentAt/emailError/lastEmailAttemptAt are written
      // only by sendInviteEmail (Cloud Functions) - the Admin SDK bypasses
      // rules entirely, so blocking these keys here just means no client
      // request (create or update) may set them, same pattern as the
      // employees/{employeeId} 'pin' field above.
      allow create: if request.auth != null &&
        isAdminOrOwner() &&
        request.auth.token.companyId == request.resource.data.companyId &&
        request.resource.data.role in ['supervisor', 'admin'] &&
        !request.resource.data.keys()
          .hasAny(['emailStatus', 'emailSentAt', 'emailError', 'lastEmailAttemptAt']);
      allow read, delete: if request.auth != null &&
        isAdminOrOwner() &&
        request.auth.token.companyId == resource.data.companyId;
      allow update: if request.auth != null &&
        isAdminOrOwner() &&
        request.auth.token.companyId == resource.data.companyId &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['emailStatus', 'emailSentAt', 'emailError', 'lastEmailAttemptAt']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}