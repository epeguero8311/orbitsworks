rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function companyOf(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)).data;
    }

    // Owner is a superset of admin - the single original-signup account
    // per company, the only role with billing/Stripe access, but
    // otherwise able to do everything admin can. Everywhere the app used
    // to gate on role == 'admin' for general (non-billing) actions now
    // goes through this helper instead.
    function isAdminOrOwner() {
      return request.auth.token.role == 'admin' || request.auth.token.role == 'owner';
    }

    function underCap(companyId) {
      let c = companyOf(companyId);
      let cap = c.get('employeeCap', null);
      let count = c.get('activeEmployeeCount', 0);
      return cap == null || !(count >= cap);
    }

    function notPastDue(companyId) {
      return companyOf(companyId).get('subscriptionStatus', 'active') != 'past_due';
    }

    // The calling supervisor's own employee doc, looked up by the
    // employeeId custom claim rather than request.auth.uid - employees
    // doc IDs are never assumed to equal the linked auth uid (a
    // promoted-in-place employee keeps its original doc ID), so this is
    // the only way rules can resolve "my own employee record" with a
    // single get() (rules can't run a where('linkedUserId','==',uid)
    // query). The employeeId claim is set by acceptInvite and
    // setEmployeeRole whenever a user gets linked to an employee doc.
    // Falls back to request.auth.uid when the employeeId claim isn't on
    // the token yet - true for every already-signed-in supervisor until
    // they get a fresh ID token (migrate-owner-role.js backfills the
    // claim, but there's no way to force a refresh of tokens already in
    // flight). Safe because doc id == uid for every employee linked
    // before this claim existed, so the fallback resolves to the same
    // doc the old uid-keyed lookup did.
    function isActiveEmployee(companyId) {
      let employeeId = request.auth.token.get('employeeId', request.auth.uid);
      return get(/databases/$(database)/documents/companies/$(companyId)/employees/$(employeeId)).data.active == true;
    }

    // A deactivated employee can still have an open clock session (the
    // deactivation write itself auto-closes it, but this is the safety net
    // for when that write fails, plus the backfill path for sessions that
    // were already orphaned before that fix shipped). Such an employee must
    // still be clockable OUT - just never back IN or onto a new break -
    // so admin manual clock-out, the Alerts panel, and the mobile app can
    // all still close it out. lastEventType is the same denormalized field
    // onClockEventCreated keeps in sync, so this needs only one get(), no
    // query.
    function isActiveOrClosingOpenSession(companyId, employeeId, data) {
      let e = get(/databases/$(database)/documents/companies/$(companyId)/employees/$(employeeId)).data;
      return e.active == true ||
        (e.get('lastEventType', 'out') != 'out' && data.type in ['out', 'breakEnd']);
    }

    function isActiveSupervisor(companyId, employeeId) {
      let e = get(/databases/$(database)/documents/companies/$(companyId)/employees/$(employeeId)).data;
      return e.active == true && e.isSupervisor == true;
    }

    function requiresOverrideReason(companyId) {
      return companyOf(companyId).get('attendanceRules', {}).get('requireOverrideReason', true);
    }

    // A supervisorOverride clock event must name a real, currently active
    // supervisor as authorizedById (not just any client-supplied string) so
    // the audit trail this feature exists to build can't be self-forged by
    // whoever already has write access to clockEvents. reason, if present,
    // must always be well-formed (matches overrideReasonSchema's 10-500
    // bound); it's only required to be present when the company's
    // "Require Reason for Supervisor Overrides" setting is on - enforced
    // here rather than only in OverrideReasonScreen.js so it can't be
    // skipped by writing directly to Firestore.
    function isValidOverride(companyId, data) {
      return data.source != 'supervisorOverride' ||
        (
          data.authorizedById is string &&
          isActiveSupervisor(companyId, data.authorizedById) &&
          (
            data.reason == null ||
            (data.reason is string && data.reason.size() >= 10 && data.reason.size() <= 500)
          ) &&
          (!requiresOverrideReason(companyId) || data.reason != null)
        );
    }

    function isValidClockEventType(data) {
      return data.type in ['in', 'out', 'breakStart', 'breakEnd'];
    }

    // True only when an update targets the identical logical event a
    // supervisor already created - same localId, same author. This is
    // what an idempotent retry looks like after an app crash between
    // the Firestore write succeeding and the local queue cleanup
    // finishing (see queueSync.js). It intentionally does not allow
    // changing type, employeeId, or timestamps - only a same-identity
    // replay, never an after-the-fact edit of someone's clocked time.
    function isIdempotentReplay(companyId) {
      return request.auth.token.role == 'supervisor' &&
        isActiveEmployee(companyId) &&
        resource.data.createdByUid == request.auth.uid &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.localId == resource.data.localId &&
        request.resource.data.employeeId == resource.data.employeeId &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.clientTimestamp == resource.data.clientTimestamp &&
        // Device Recognition Pro - pinned the same way as the other
        // identity fields above. .get(field, null) (not direct access) is
        // required on both sides: an old app version's original event, or
        // its own replay, never had these keys at all, and direct access
        // to a missing map key throws in rules rather than returning
        // undefined.
        request.resource.data.get('deviceId', null) == resource.data.get('deviceId', null) &&
        request.resource.data.get('deviceNameSnapshot', null) == resource.data.get('deviceNameSnapshot', null);
    }

    // Device Recognition Pro. Lock freezes a device's name for EVERYONE,
    // including admins - to rename a locked device, an admin must unlock
    // it first (flip 'locked' to false), then rename in a separate write.
    // lastSeenAt/lastUserUid are excluded from every affectedKeys() list
    // on purpose: only onClockEventCreated (Admin SDK, bypasses rules)
    // ever writes them, via a transaction against an already-existing doc
    // (see functions/src/clockEvents.ts) - no client path here ever needs
    // to touch them.
    function isValidDeviceRename(companyId) {
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      return !diff.hasAny(['lastSeenAt', 'lastUserUid']) &&
        (!diff.hasAny(['name']) ||
          (request.resource.data.name is string &&
           request.resource.data.name.size() >= 1 &&
           request.resource.data.name.size() <= 24)) &&
        (!diff.hasAny(['updatedByUid']) || request.resource.data.updatedByUid == request.auth.uid) &&
        (!diff.hasAny(['lockedByUid']) || request.resource.data.lockedByUid == request.auth.uid) &&
        (
          (resource.data.get('locked', false) == false &&
            (
              (isAdminOrOwner() &&
               diff.hasOnly(['name', 'updatedAt', 'updatedByUid', 'locked', 'lockedByUid', 'lockedAt'])) ||
              ((request.auth.token.role == 'supervisor' && isActiveEmployee(companyId)) &&
               diff.hasOnly(['name', 'updatedAt', 'updatedByUid']))
            )) ||
          (resource.data.get('locked', false) == true &&
            isAdminOrOwner() &&
            diff.hasOnly(['locked', 'lockedByUid', 'lockedAt']))
        );
    }

    // A client may only ever append its own device id to an alert's
    // readByDeviceIds - never touch any other field, never remove or
    // reorder an existing entry (hasAll requires every prior id still be
    // present), and never add more than one id per call. deviceId itself
    // is self-asserted (same as everywhere else in this app - there's no
    // separate per-device auth) - this bounds the blast radius of a bad
    // actor to "mark alerts read for a device id of their choosing," never
    // to editing an alert's actual content or another device's read state.
    function isOwnReadStateUpdate() {
      let before = resource.data.get('readByDeviceIds', []);
      let after = request.resource.data.readByDeviceIds;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByDeviceIds']) &&
        after.size() == before.size() + 1 &&
        after.hasAll(before);
    }

    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (isAdminOrOwner() &&
         request.auth.token.companyId == resource.data.companyId)
      );
      allow create, update, delete: if false;
    }

    match /companies/{companyId} {
      allow read: if request.auth != null &&
        request.auth.token.companyId == companyId;
      allow create: if false;
      allow update: if request.auth != null &&
        isAdminOrOwner() &&
        request.auth.token.companyId == companyId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'planTier',
          'employeeCap',
          'subscriptionStatus',
          'activeEmployeeCount',
          'stripeCustomerId',
          'stripeSubscriptionId',
          'trialEndsAt'
        ]) &&
        // Face Verification (Pro) - checks themselves always run for Pro,
        // never for Core, with no company opt-out (functions/src/
        // rekognition.ts). The only remaining knob is
        // faceVerification.alertsEnabled, writable by owner/admin only
        // while the company's current planTier (immutable in this same
        // write - see the denylist above) is Pro.
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['faceVerification']) ||
          resource.data.get('planTier', '').matches('^pro_.*')
        );
      allow delete: if false;

      match /jobSites/{siteId} {
        allow read: if request.auth != null &&
          request.auth.token.companyId == companyId;
        allow write: if request.auth != null &&
          isAdminOrOwner() &&
          request.auth.token.companyId == companyId;
      }

      match /jobs/{jobId} {
        allow read: if request.auth != null &&
          request.auth.token.companyId == companyId;
        allow write: if request.auth != null &&
          isAdminOrOwner() &&
          request.auth.token.companyId == companyId;
      }

      match /subcontractors/{subcontractorId} {
        allow read: if request.auth != null &&
          request.auth.token.companyId == companyId;
        allow write: if request.auth != null &&
          isAdminOrOwner() &&
          request.auth.token.companyId == companyId;
      }

      match /employees/{employeeId} {
        allow read: if request.auth != null &&
          request.auth.token.companyId == companyId;

        // faceStatus/faceReference are both server-written-only fields
        // (see the update rule's comment below) - denied here too, not
        // just on update, so a direct create can't forge either one
        // in the brief window before the Admin SDK (addEmployee/
        // createEmployee, which bypass rules) would otherwise set them.
        allow create: if request.auth != null &&
          isAdminOrOwner() &&
          request.auth.token.companyId == companyId &&
          !request.resource.data.keys().hasAny(['faceStatus', 'faceReference']) &&
          (request.resource.data.active != true || (underCap(companyId) && notPastDue(companyId)));

        // isAdmin/isSupervisor/linkedUserId are role-like fields - only
        // acceptInvite, setEmployeeRole, setEmployeePinSupervisor, and
        // deleteEmployee (all Admin SDK, bypass rules) may change them,
        // so they're kept in sync
        // with users/{uid}.role and the custom claim. Same lockdown
        // pattern as 'pin' below. faceStatus is the same treatment -
        // only createEmployee (Admin SDK) sets it at creation, and only
        // the future AWS Rekognition enrollment step (also Admin SDK)
        // may ever flip it to "enrolled" - no client, including an
        // admin, edits it directly. faceReference is Face Verification
        // (Pro) - server-written only, by the reference-photo-check
        // Cloud Function (Admin SDK) - see functions/src/rekognition.ts.
        allow update: if request.auth != null &&
          isAdminOrOwner() &&
          request.auth.token.companyId == companyId &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['subcontractorId', 'subcontractorName', 'subcontractorHistory', 'pin', 'isAdmin', 'isSupervisor', 'linkedUserId', 'faceStatus', 'faceReference']) &&
          (
            request.resource.data.active != true ||
            resource.data.active == true ||
            (underCap(companyId) && notPastDue(companyId))
          );

        // No client, including admins, may delete an employee doc
        // directly - the only path is the deleteEmployee callable (Admin
        // SDK, bypasses rules), which closes any open session, releases
        // the PIN, and cleans up the linked Auth account/invite first.
        // clockEvents/timesheetApprovals denormalize employeeName/
        // siteName/etc at write time, so historical timesheets and
        // reports still read correctly after this doc is gone.
        allow delete: if false;
      }

      match /pins/{pinId} {
        // Server-only reservation index for PIN uniqueness (see
        // setEmployeePin / backfillEmployeePins / reserveNewPin in
        // functions). No client needs to read or write this directly -
        // the Admin SDK bypasses rules entirely, so this is an explicit,
        // readable deny rather than relying on it falling through
        // unmatched.
        allow read, write: if false;
      }

      match /clockEvents/{eventId} {
        allow read: if request.auth != null &&
          request.auth.token.companyId == companyId;
        allow create: if request.auth != null &&
          request.auth.token.companyId == companyId &&
          isValidClockEventType(request.resource.data) &&
          isActiveOrClosingOpenSession(companyId, request.resource.data.employeeId, request.resource.data) &&
          (
            isAdminOrOwner() ||
            (request.auth.token.role == 'supervisor' &&
             isActiveEmployee(companyId))
          ) &&
          request.resource.data.createdByUid == request.auth.uid &&
          isValidOverride(companyId, request.resource.data) &&
          // No client ever sends these (onClockEventCreated fills them in
          // after the fact - see the update rule below) - denying them at
          // create time too closes even the brief window before that
          // trigger runs, not just a later replay. siteId/siteName aren't
          // here - a client does legitimately send an initial guess for
          // those (auto-detection only ever corrects them after the fact,
          // via the update rule below).
          // faceCheck (Face Verification, Pro) joins this denylist for the
          // same reason - onClockEventCreated writes it after the fact
          // (Admin SDK), so no client gets even a brief window to set it
          // at create time either.
          !request.resource.data.keys().hasAny([
            'geofenceStatus', 'distanceFromSiteM', 'locationAddress',
            'siteCorrected', 'siteMismatch', 'siteAutoDetected', 'faceCheck'
          ]);
        allow update: if request.auth != null &&
          request.auth.token.companyId == companyId &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              'type', 'timestamp', 'adjustedTimestamp', 'adjustmentHistory', 'employeeId',
              'employeeName', 'subcontractorId', 'subcontractorName', 'reason',
              // Only ever written by onClockEventCreated (Admin SDK, bypasses
              // rules entirely) - never trust a client-supplied classification
              // or distance, same reasoning as reason/etc above (Geofencing
              // Part 3 - see functions/src/clockEvents.ts). siteId/siteName/
              // siteCorrected/siteMismatch are the auto-detection additions -
              // once a client creates the event with its initial guess, only
              // that same trigger is ever allowed to correct it.
              'geofenceStatus', 'distanceFromSiteM', 'locationAddress',
              'siteId', 'siteName', 'siteCorrected', 'siteMismatch', 'siteAutoDetected',
              // Device Recognition Pro - same "write-once at creation,
              // never editable after" treatment as employeeId/siteId
              // above. onClockEventCreated never writes back to these on
              // the event itself (Device logic never modifies the clock
              // event - see functions/src/clockEvents.ts), so nothing,
              // not even an admin correction, should silently rewrite
              // which device a past event is attributed to.
              'deviceId', 'deviceNameSnapshot',
              // Face Verification (Pro) - server-written only, by
              // onClockEventCreated/reassignClockEvent (Admin SDK) - see
              // functions/src/rekognition.ts. Never trust a client-supplied
              // match result, same reasoning as geofenceStatus above.
              'faceCheck'
            ]) &&
          (
            isAdminOrOwner() ||
            isIdempotentReplay(companyId)
          );
        allow delete: if request.auth != null &&
          isAdminOrOwner() &&
          request.auth.token.companyId == companyId;
      }

      match /devices/{deviceId} {
        // Read: supervisor or admin/owner only - not every employee, per
        // spec. isActiveEmployee gates the supervisor branch so a
        // deactivated supervisor's still-valid login can't keep browsing
        // device names, same active-employee gate the clockEvents create
        // rule already applies to supervisors above.
        allow read: if request.auth != null &&
          request.auth.token.companyId == companyId &&
          (isAdminOrOwner() ||
           (request.auth.token.role == 'supervisor' && isActiveEmployee(companyId)));

        // A device doc is only ever created the first time someone names
        // an unnamed device (mobile Settings / web Devices section) -
        // never auto-created by onClockEventCreated, which only ever
        // updates an EXISTING doc (see functions/src/clockEvents.ts).
        // locked/lockedByUid/lockedAt/lastSeenAt/lastUserUid are absent
        // from the allowed key set on purpose - a brand new device can't
        // be created already locked or with a fabricated seen history.
        allow create: if request.auth != null &&
          request.auth.token.companyId == companyId &&
          (isAdminOrOwner() ||
           (request.auth.token.role == 'supervisor' && isActiveEmployee(companyId))) &&
          request.resource.data.keys().hasOnly(['name', 'platform', 'model', 'createdByUid', 'createdAt']) &&
          request.resource.data.createdByUid == request.auth.uid &&
          request.resource.data.name is string &&
          request.resource.data.name.size() >= 1 &&
          request.resource.data.name.size() <= 24 &&
          request.resource.data.platform in ['ios', 'android', ''];

        allow update: if request.auth != null &&
          request.auth.token.companyId == companyId &&
          isValidDeviceRename(companyId);

        // No client, including admins, may delete a device doc directly -
        // a deleted device would orphan every past clockEvents.deviceId
        // it's named for, and there's no callable that needs this today.
        // Same "no client delete" convention as employees/{employeeId}
        // above.
        allow delete: if false;
      }

      match /alertActions/{actionId} {
        allow read: if request.auth != null &&
          request.auth.token.companyId == companyId;
        allow create: if request.auth != null &&
          request.auth.token.companyId == companyId &&
          (
            isAdminOrOwner() ||
            (request.auth.token.role == 'supervisor' &&
             isActiveEmployee(companyId))
          ) &&
          request.resource.data.resolvedByUid == request.auth.uid;
        allow update, delete: if false;
      }

      // Server-written only, by the alert-generation Cloud Function
      // (Admin SDK, bypasses rules) - see functions/src/alerts.ts. A
      // client may read its own company's alerts (the mobile Alerts tab
      // filters by assignedSiteIds client-side, same as clockEvents/
      // employees already do for supervisors) and may update only its
      // own device's read state - see isOwnReadStateUpdate() above.
      match /alerts/{alertId} {
        allow read: if request.auth != null &&
          request.auth.token.companyId == companyId;
        allow create, delete: if false;
        allow update: if request.auth != null &&
          request.auth.token.companyId == companyId &&
          isOwnReadStateUpdate();
      }

      // A device reads its own token doc before writing (to preserve its
      // existing notificationsEnabled preference and createdAt across
      // re-registration) - rules can't verify "this is literally the same
      // device" for a plain read (no device identity in the auth token,
      // same limitation as isOwnReadStateUpdate() above), so this allows
      // same-company read, matching the pattern already used for alerts/
      // clockEvents/employees. A device may create/update only its own
      // token doc (doc id must equal the deviceId field inside it) for
      // its own company, and only with a well-formed Expo token (matches
      // functions/src/pushTokens.ts's EXPO_PUSH_TOKEN_PATTERN); never
      // delete - disabling notifications flips notificationsEnabled
      // instead, so a stale-token cleanup always has a doc to find and
      // remove server-side.
      match /pushTokens/{deviceId} {
        // get only, never list: the client only ever reads its own doc by
        // its own known deviceId (lib/pushNotifications.js never queries
        // this collection). Allowing list would let any same-company user
        // enumerate every deviceId, defeating the "unguessable UUID"
        // assumption the create/update check below relies on, and from
        // there overwrite another device's token to redirect its alert
        // pushes - a real confidentiality issue, not just a theoretical
        // one, since alert content includes employee/site names.
        allow get: if request.auth != null &&
          request.auth.token.companyId == companyId;
        allow list: if false;
        allow delete: if false;
        allow create, update: if request.auth != null &&
          request.auth.token.companyId == companyId &&
          request.resource.data.deviceId == deviceId &&
          request.resource.data.token is string &&
          request.resource.data.token.matches('^Expo(nent)?PushToken\\[[A-Za-z0-9_-]+\\]$') &&
          request.resource.data.platform in ['ios', 'android'];
      }

      match /shiftNotes/{noteId} {
        allow read: if request.auth != null &&
          request.auth.token.companyId == companyId;
        allow write: if request.auth != null &&
          request.auth.token.companyId == companyId &&
          (isAdminOrOwner() || request.auth.token.role == 'supervisor');
      }

      match /timesheetApprovals/{eventId} {
        // Admin/owner-only, server-created. Written only by
        // onClockEventCreated and setApprovalStatus (both Admin SDK,
        // bypass rules entirely) - clients can read for the Approvals
        // page but never write status/approvedBy/approvedAt directly,
        // same lockdown pattern as adjustmentHistory on clockEvents.
        allow read: if request.auth != null &&
          request.auth.token.companyId == companyId &&
          isAdminOrOwner();
        allow write: if false;
      }

      match /overrideEvents/{overrideEventId} {
        // Server-created only, by onClockEventCreated (Admin SDK, bypasses
        // rules entirely) whenever a supervisorOverride clock event carries
        // a reason. Same lockdown pattern as timesheetApprovals - clients
        // read for the Approvals page's override-detail view, never write.
        allow read: if request.auth != null &&
          request.auth.token.companyId == companyId &&
          isAdminOrOwner();
        allow write: if false;
      }
    }

    // Help-chat telemetry - server-only, written by the Admin SDK from
    // app/api/help-chat/route.ts and lib/help-chat/rateLimit.ts. This is
    // internal training/eval data (what answered well, what missed, what
    // errored) - not a user-facing feature, so no client, including admins,
    // ever needs to read or write it. Explicit deny rather than relying on
    // the trailing catch-all, same pattern as /pins.
    match /helpChatLimits/{docId} {
      allow read, write: if false;
    }
    match /helpChatLogs/{logId} {
      allow read, write: if false;
    }
    match /helpChatMisses/{missId} {
      allow read, write: if false;
    }
    match /helpChatErrors/{errId} {
      allow read, write: if false;
    }

    // Places autocomplete/details rate-limit counters - server-only,
    // written by the Admin SDK from lib/places/rateLimit.ts. Same pattern
    // as /helpChatLimits above: no client, including admins, ever needs to
    // read or write it.
    match /placesApiLimits/{docId} {
      allow read, write: if false;
    }

    match /invites/{inviteId} {
      // emailStatus/emailSentAt/emailError/lastEmailAttemptAt are written
      // only by sendInviteEmail (Cloud Functions) - the Admin SDK bypasses
      // rules entirely, so blocking these keys here just means no client
      // request (create or update) may set them, same pattern as the
      // employees/{employeeId} 'pin' field above.
      allow create: if request.auth != null &&
        isAdminOrOwner() &&
        request.auth.token.companyId == request.resource.data.companyId &&
        request.resource.data.role in ['supervisor', 'admin'] &&
        !request.resource.data.keys()
          .hasAny(['emailStatus', 'emailSentAt', 'emailError', 'lastEmailAttemptAt']);
      allow read, delete: if request.auth != null &&
        isAdminOrOwner() &&
        request.auth.token.companyId == resource.data.companyId;
      allow update: if request.auth != null &&
        isAdminOrOwner() &&
        request.auth.token.companyId == resource.data.companyId &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['emailStatus', 'emailSentAt', 'emailError', 'lastEmailAttemptAt']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}