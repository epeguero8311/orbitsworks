rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (request.auth.token.role == 'admin' &&
         request.auth.token.companyId == resource.data.companyId)
      );
      // All writes now go through the createCompany / acceptInvite Cloud
      // Functions via the Admin SDK, which bypasses these rules entirely.
      // Clients have no legitimate reason to write here directly.
      allow create, update, delete: if false;
    }

    match /companies/{companyId} {
      allow read: if request.auth != null &&
        request.auth.token.companyId == companyId;
      // New companies are only created via the createCompany Cloud Function.
      allow create: if false;
      allow update: if request.auth != null &&
        request.auth.token.role == 'admin' &&
        request.auth.token.companyId == companyId;
      allow delete: if false;

      match /jobSites/{siteId} {
        allow read: if request.auth != null &&
          request.auth.token.companyId == companyId;
        allow write: if request.auth != null &&
          request.auth.token.role == 'admin' &&
          request.auth.token.companyId == companyId;
      }

      match /employees/{employeeId} {
        allow read: if request.auth != null &&
          request.auth.token.companyId == companyId;
        allow write: if request.auth != null &&
          request.auth.token.role == 'admin' &&
          request.auth.token.companyId == companyId;
      }

      match /clockEvents/{eventId} {
        allow read: if request.auth != null &&
          request.auth.token.companyId == companyId;
        allow create: if request.auth != null &&
          request.auth.token.companyId == companyId &&
          (request.auth.token.role == 'admin' || request.auth.token.role == 'supervisor') &&
          request.resource.data.createdByUid == request.auth.uid;
        allow update, delete: if request.auth != null &&
          request.auth.token.role == 'admin' &&
          request.auth.token.companyId == companyId;
      }

      match /shiftNotes/{noteId} {
        allow read: if request.auth != null &&
          request.auth.token.companyId == companyId;
        allow write: if request.auth != null &&
          request.auth.token.companyId == companyId &&
          (request.auth.token.role == 'admin' || request.auth.token.role == 'supervisor');
      }
    }

    match /invites/{inviteId} {
      allow create: if request.auth != null &&
        request.auth.token.role == 'admin' &&
        request.auth.token.companyId == request.resource.data.companyId;
      allow read, update, delete: if request.auth != null &&
        request.auth.token.role == 'admin' &&
        request.auth.token.companyId == resource.data.companyId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
