{
  "cli": {
    "version": ">= 21.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "dev": {
      "extends": "development",
      "channel": "dev",
      "env": {
        "EXPO_PUBLIC_FIREBASE_API_KEY": "REPLACE_WITH_ORBITWORKS_DEV_EW_FIREBASE_API_KEY",
        "EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN": "orbitworks-dev-ew.firebaseapp.com",
        "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "orbitworks-dev-ew",
        "EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET": "orbitworks-dev-ew.firebasestorage.app",
        "EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "REPLACE_WITH_ORBITWORKS_DEV_EW_MESSAGING_SENDER_ID",
        "EXPO_PUBLIC_FIREBASE_APP_ID": "REPLACE_WITH_ORBITWORKS_DEV_EW_APP_ID"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6801155800"
      }
    }
  }
}
