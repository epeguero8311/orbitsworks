{
  "expo": {
    "name": "OrbitsWorks",
    "slug": "orbitworks",
    "version": "1.1.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.orbitworks.app",
      "buildNumber": "8",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.orbitworks.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "OrbitWorks needs camera access to capture proof photos for clock-ins."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OrbitsWorks saves where you clock in, clock out and take breaks. If your company uses job site geofences, it can also note when you leave the job site while you are clocked in.",
          "locationAlwaysAndWhenInUsePermission": "While you are clocked in at a job site with a geofence, OrbitsWorks checks in the background when you leave and come back to the job site. It never runs while you are clocked out and never saves a trail of where you went.",
          "locationAlwaysPermission": "While you are clocked in at a job site with a geofence, OrbitsWorks checks in the background when you leave and come back to the job site. It never runs while you are clocked out and never saves a trail of where you went.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": false,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#3b6fe0"
        }
      ],
      "expo-sqlite",
      "expo-status-bar",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "orbitworks-app",
          "organization": "orbitsworks"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#3b6fe0",
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b0246607-adc6-477f-aae8-39ea905373e8"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b0246607-adc6-477f-aae8-39ea905373e8"
    }
  }
}
