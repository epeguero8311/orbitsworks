# Copy to .env.local and fill in. See lib/firebase.js - all 6 Firebase
# vars below are required at startup (throws if any are missing).
# For an EAS build (not local `expo start`), these come from eas.json's
# per-profile `env` block instead - this file is for local dev only.

# --- Firebase client config (public - compiled into every bundle) ---
# Firebase console > Project settings > General > Your apps > SDK setup
# (Expo apps use the Web app's config shape), or
# `firebase apps:sdkconfig web --project <project-id>`.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Optional - omit to skip an explicit GA4 measurement id.
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Sentry source-map upload (build-time only, not read by the app) ---
SENTRY_AUTH_TOKEN=
